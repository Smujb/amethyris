#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
  exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
cd .sources

# Prepare still for an offline build
git clone https://github.com/faergeek/still
cd still
meson setup --buildtype release build

# Prepare PKGBUILDs for offline builds
cd ..
cp -R ../other_packages/* ./
cd obs-vkcapture
env EUID=123 PATH=$(realpath .):$PATH makepkg -o

cd ../wlogout
# Import necessary pgp key
gpg --import *.asc
env EUID=123 PATH=$(realpath .):$PATH makepkg -o
