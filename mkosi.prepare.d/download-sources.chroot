#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
  exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
pushd .sources

# Prepare still for an offline build
git clone https://github.com/faergeek/still
pushd still
meson setup --buildtype release build
popd

# Import keys.
gpg --import ../keys/*.asc

# Prepare PKGBUILDs for offline builds, apply patches.
cp -R ../thirdparty/* ./
pushd obs-vkcapture
git apply ../../patches/obs-vkcapture/*.patch
env EUID=123 PATH=$(realpath .):$PATH makepkg -o
popd

pushd wlogout
env EUID=123 PATH=$(realpath .):$PATH makepkg -o
popd
