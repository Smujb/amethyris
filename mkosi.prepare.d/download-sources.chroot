#!/usr/bin/env bash

set -uexo pipefail

if [ $1 != "build" ]; then
  exit
fi

# Ensure the sources dir exists and is empty
mkdir -p .sources
rm -rf .sources/*
pushd .sources

# Prepare still for an offline build
git clone https://github.com/faergeek/still
pushd still
meson setup --buildtype release build
popd

# Import keys.
gpg --import ../keys/*.asc

# Prepare PKGBUILDs for offline builds, apply patches.
# Copy all sources in from our submodules and AUR packages
cp -R ../thirdparty/* ./
cp -R ../subprojects/arch-bootc-pkgs/pkgs/* ./
cp -R ../subprojects/homebrew-arch/pkgs/* ./

# Enter build directory, apply patches, download sources and then leave it
for pkg in ${SOURCE_PKGS[@]}; do
  pushd $pkg
  # We use patch instead of git apply as not all pkgbuilds being copied in are from their project root
  [ -d "../../patches/$pkg" ] && patch <../../patches/$pkg/*.patch
  env EUID=123 makepkg --nobuild
  popd
done
