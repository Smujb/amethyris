#!/usr/bin/env bash

set -uexo pipefail

cd .sources
install still/build/still /usr/bin

# Install all packages in .sources/[package name]
# We pipe in yes to auto-accept prompts that default to no, and we ignore exit code 1 by || with true
# FIXME This is a horrible hack that will become unnecessary once I figure out how to package homebrew for this project
yes | pacman -U ./*/*.pkg.tar.* --disable-sandbox || true
