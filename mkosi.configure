#!/usr/bin/env python3
import datetime
import json
import os
import sys

# Read configuration from stdin
input = sys.stdin.readline()
CONFIG = json.loads(input)
IMAGE_VERSION = os.environ["IMAGE_VERSION"]

# Convert the image version into an Arch Linux Archive reference
UPDATE_DATE = ""
with open("archive.lock") as archive_lock:
    UPDATE_DATE = archive_lock.read().strip()

if UPDATE_DATE == "":
    raise ValueError("archive.lock not populated")

# And convert that to a UNIX timestamp (12:00 UTC on the day)
UPDATE_EPOCH = (
    datetime.datetime.strptime(UPDATE_DATE, "%Y/%m/%d")
    .astimezone(datetime.timezone.utc)
    .timestamp()
)

CONFIG["Snapshot"] = UPDATE_DATE
CONFIG["SourceDateEpoch"] = int(UPDATE_EPOCH)
CONFIG["Environment"] = {"SNAPSHOT": UPDATE_DATE}

json.dump(CONFIG, sys.stdout)
